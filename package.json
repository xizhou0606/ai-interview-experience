{
  "name": "ai-practice-field-guide",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "npm run lint:architecture && npm run lint:comparisons && npm run lint:api-content && npm run lint:framework-api && npm run lint:endpoints && tsc -b && vite build",
    "lint:architecture": "node scripts/check-architecture.mjs",
    "lint:comparisons": "node scripts/check-technology-comparisons.mjs",
    "lint:api-content": "node scripts/check-api-content.mjs",
    "lint:framework-api": "node scripts/check-framework-api-content.mjs",
    "lint:endpoints": "node scripts/check-endpoint-content.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview --host 127.0.0.1"
  },
  "dependencies": {
    "lucide-react": "1.23.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "typescript": "6.0.3",
    "vite": "7.3.6"
  }
}
